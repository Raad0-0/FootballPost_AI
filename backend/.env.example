# Security
SECRET_KEY=change-me-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./clubpost.db

# AI Studio (Google Gemini) - Free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Football Data Provider - Free at https://www.football-data.org/client/register
# Setting this key switches ClubPost from mock data to real-time live match tracking!
FOOTBALL_DATA_API_KEY=
FOOTBALL_PROVIDER=auto

# CORS Configuration (* for all, or comma-separated origins)
CORS_ORIGINS=*
